# Root .gitignore for the project
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Node modules (backend and frontend)
/backend/node_modules/
/frontend/node_modules/

# Yarn and PNPM lockfiles and directories
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output directories
/frontend/.next/
/frontend/dist/
/frontend/build/
/backend/dist/
/backend/build/

# Production build files
/out/

# Coverage reports
/coverage

# Env files
.env
.env.*

# OS generated files
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# IDE/editor folders
.vscode/
.idea/

# Misc
*.pem

# TypeScript cache
*.tsbuildinfo
next-env.d.ts
